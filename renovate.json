{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "npm:unpublishSafe",
    "schedule:daily",
    ":maintainLockFilesWeekly",
    ":disableDependencyDashboard",
    ":automergeMinor",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":label(area: dependencies)"
  ],
  "prConcurrentLimit": 20,
  "prHourlyLimit": 20,
  "ignorePaths": ["**/node_modules/**", "**/test/**", "src/main/resources/generator/dependencies/svelte/**"],
  "docker-compose": {
    "fileMatch": ["^src/main/docker/[^/]*\\.ya?ml$"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["node"],
      "allowedVersions": "<25.0.0"
    },
    {
      "matchPackageNames": ["net.jqwik:jqwik"],
      "allowedVersions": "1.9.3"
    },
    {
      "description": "Angular packages have strict peer dependencies on each other: major upgrades must be done together",
      "matchFileNames": ["src/main/resources/generator/dependencies/angular/package.json"],
      "matchPackageNames": ["@angular/**", "angular-eslint"],
      "matchUpdateTypes": ["major"],
      "groupName": "angular major"
    },
    {
      "description": "Major updates get an additional label so they appear in release notes",
      "matchUpdateTypes": ["major"],
      "addLabels": ["area: major dependencies"]
    }
  ]
}

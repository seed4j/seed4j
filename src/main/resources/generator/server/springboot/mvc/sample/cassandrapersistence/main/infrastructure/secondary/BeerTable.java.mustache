package {{ packageName }}.sample.infrastructure.secondary;

import {{ packageName }}.shared.generation.domain.ExcludeFromGeneratedCodeCoverage;
import {{ packageName }}.sample.domain.BeerId;
import {{ packageName }}.sample.domain.beer.Beer;
import {{ packageName }}.sample.domain.beer.BeerSellingState;
import {{ packageName }}.shared.error.domain.Assert;
import org.apache.commons.lang3.builder.EqualsBuilder;
import org.apache.commons.lang3.builder.HashCodeBuilder;
import org.springframework.data.cassandra.core.mapping.Column;
import org.springframework.data.cassandra.core.mapping.PrimaryKey;
import org.springframework.data.cassandra.core.mapping.Table;

import java.math.BigDecimal;
import java.util.UUID;

@Table("beer")
final class BeerTable {

  @PrimaryKey("id")
  private final UUID id;

  @Column("name")
  private final String name;

  @Column("unit_price")
  private final BigDecimal unitPrice;

  @Column("selling_state")
  private final BeerSellingState sellingState;

  private BeerTable(UUID id, String name, BigDecimal unitPrice, BeerSellingState sellingState) {
    this.id = id;
    this.name = name;
    this.unitPrice = unitPrice;
    this.sellingState = sellingState;
  }

  public static BeerTable from(Beer beer) {
    Assert.notNull("beer", beer);

    return new BeerTable(beer.id().get(), beer.name().get(), beer.unitPrice().get(), beer.sellingState());
  }

  public Beer toDomain() {
    return Beer.builder().id(new BeerId(id)).name(name).unitPrice(unitPrice).sellingState(sellingState).build();
  }

  @Override
  @ExcludeFromGeneratedCodeCoverage
  public int hashCode() {
    return new HashCodeBuilder().append(id).hashCode();
  }

  @Override
  @ExcludeFromGeneratedCodeCoverage
  public boolean equals(Object o) {
    if (this == o) {
      return true;
    }

    if (o == null || getClass() != o.getClass()) {
      return false;
    }

    BeerTable other = (BeerTable) o;

    return new EqualsBuilder().append(id, other.id).isEquals();
  }
}

import { Button, InputGroup, Modal } from '@heroui/react';
import { useCallback, useContext, useState } from 'react';
import { useForm } from 'react-hook-form';

import { EyeFilledIcon } from './EyeFilledIcon';
import { EyeSlashFilledIcon } from './EyeSlashFilledIcon';

import { UserInfoContext } from '@/login/primary/loginForm';
import { login } from '@/login/services/login';

import './LoginModal.scss';

const LoginModal = ({ open, onClose }: LoginModalType) => {
  const { register, handleSubmit } = useForm<LoginFunctionType>();
  const [error, setError] = useState(false);
  const [isVisible, setIsVisible] = useState(false);
  const { setUsername, setToken } = useContext(UserInfoContext);

  const toggleVisibility = () => setIsVisible(!isVisible);

  const onSubmit = async (loginData: LoginFunctionType) => {
    if (loginData.username && loginData.password) {
      await login({ ...loginData, setUsername, setToken });
      setError(false);
      onClose();
    } else {
      setError(true);
    }
  };

  const handleClose = useCallback(() => {
    setError(false);
    onClose();
  }, []);

  return (
    <Modal isOpen={open} onOpenChange={handleClose}>
      <Modal.Backdrop variant="blur">
        <Modal.Container>
          <Modal.Dialog aria-labelledby="modal-login">
            <Modal.CloseTrigger />
            <Modal.Header>
              <Modal.Heading id="modal-login" className="flex gap-1">
                <span>Connect</span>
                <span>Seed4J</span>
              </Modal.Heading>
            </Modal.Header>
            <Modal.Body>
              <form className="flex flex-col gap-2" onSubmit={handleSubmit(onSubmit)}>
                <InputGroup fullWidth>
                  <InputGroup.Input
                    aria-label="modal-login-username"
                    data-testid="modal-login-username"
                    placeholder="Username"
                    type="text"
                    {...register('username')}
                  />
                </InputGroup>
                <InputGroup fullWidth>
                  <InputGroup.Input
                    aria-label="modal-login-password"
                    data-testid="modal-login-password"
                    placeholder="Password"
                    type={isVisible ? 'text' : 'password'}
                    {...register('password')}
                  />
                  <InputGroup.Suffix>
                    <button data-testid="display-password" className="focus:outline-none" type="button" onClick={toggleVisibility}>
                      {isVisible ? (
                        <EyeSlashFilledIcon className="text-2xl text-muted pointer-events-none" />
                      ) : (
                        <EyeFilledIcon className="text-2xl text-muted pointer-events-none" />
                      )}
                    </button>
                  </InputGroup.Suffix>
                </InputGroup>
                {error && (
                  <p data-testid="error-message" color="error">
                    Please complete the fields above
                  </p>
                )}
                <div className="flex gap-2">
                  <input type="checkbox" {...register('rememberMe')} />
                  <span>Remember me</span>
                </div>
                <Button data-testid="submit-button" className="submit-button" type="submit" variant="primary">
                  Log in
                </Button>
              </form>
            </Modal.Body>
          </Modal.Dialog>
        </Modal.Container>
      </Modal.Backdrop>
    </Modal>
  );
};

export default LoginModal;

{
  "name": "seed4j",
  "version": "2.2.1-SNAPSHOT",
  "private": true,
  "description": "seed4j",
  "homepage": "https://seed4j.com/",
  "bugs": "https://github.com/seed4j/seed4j/issues",
  "repository": {
    "type": "git",
    "url": "git://github.com/seed4j/seed4j.git"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/seed4j"
  },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "npm-run-all build:*",
    "build:tikui": "tikui-core build",
    "build:tsc": "vue-tsc -p tsconfig.build.json --noEmit",
    "build:vite": "vite build --emptyOutDir",
    "dev": "npm-run-all --parallel dev:*",
    "dev:tikui": "tikui-core serve",
    "dev:vite": "vite",
    "e2e": "playwright test --ui -c src/test/webapp/e2e/playwright.config.ts",
    "e2e:headless": "playwright test -c src/test/webapp/e2e/playwright.config.ts",
    "glyph:build": "rimraf .fontello-session && fontello-cli install --config src/main/glyph/config.json --font src/main/glyph/font --css src/main/glyph/css",
    "glyph:open": "rimraf .fontello-session && fontello-cli open --config src/main/glyph/config.json",
    "lint": "oxlint --fix && npm run lint:sass",
    "lint:ci": "oxlint && npm run typecheck",
    "lint:ci:sass": "stylelint '**/*.{css,scss}'",
    "lint:sass": "npm run lint:ci:sass -- --fix",
    "preview": "vite preview",
    "start": "npm run dev",
    "test": "npm run test:watch",
    "test:component": "playwright test --ui -c src/test/webapp/component/playwright.config.ts",
    "test:component:headless": "playwright test -c src/test/webapp/component/playwright.config.ts && npm run test:component:merge-coverage",
    "test:component:merge-coverage": "nyc merge target/frontend-coverage/components-tests/raw target/frontend-coverage/components-tests/coverage-final.json",
    "test:coverage:check": "npm-run-all test:coverage:clean test:coverage:copy:* test:coverage:merge test:coverage:report",
    "test:coverage:clean": "rimraf target/.nyc_output",
    "test:coverage:copy:component": "cpy --flat target/frontend-coverage/components-tests/coverage-final.json target/.nyc_output/ --rename=component-{{basename}}",
    "test:coverage:copy:unit": "cpy --flat target/frontend-coverage/unit-tests/coverage-final.json target/.nyc_output/ --rename=unit-{{basename}}",
    "test:coverage:merge": "nyc merge target/.nyc_output target/.nyc_output/frontend-combined-coverage.json",
    "test:coverage:report": "nyc report",
    "test:install-browser": "playwright install --only-shell chromium",
    "test:unit:coverage": "vitest run --coverage",
    "test:watch": "vitest --",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && vue-tsc -p src/test/webapp/tsconfig.json --noEmit",
    "watch:": "npm-run-all --parallel watch:*",
    "watch:test": "npm run test:watch",
    "watch:tsc": "npm run build:tsc -- --watch"
  },
  "dependencies": {
    "axios": "1.21.0",
    "mitt": "3.0.1",
    "piqure": "2.3.0",
    "placeholder-loading": "0.7.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tikui/core": "8.0.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-istanbul": "5.1.0",
    "@vue/test-utils": "2.5.1",
    "cpy-cli": "7.0.0",
    "eslint-plugin-playwright": "2.12.2",
    "fontello-cli": "0.6.2",
    "jsdom": "31.0.0",
    "npm-run-all2": "9.0.4",
    "nyc": "18.0.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "postcss-scss": "4.0.9",
    "rimraf": "6.1.4",
    "sass": "1.108.0",
    "stylelint": "17.16.0",
    "stylelint-config-concentric-order": "5.5.0",
    "stylelint-config-standard-scss": "17.0.0",
    "tikuidoc-tikui": "9.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vite-plugin-istanbul": "9.0.1",
    "vitest": "5.1.0",
    "vitest-sonar-reporter": "3.0.0",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": ">=20"
  }
}
